// ============================================================================
// module.modulemap
//
// This file tells the Swift compiler where to find our C++ headers.
// When Swift sees `import EdgeBridgeCxx`, it looks at this modulemap
// to know which headers to parse and expose as Swift types.
//
// Without this file, Swift has no idea our C++ code exists.
// ============================================================================

module EdgeBridgeCxx {
    // The umbrella header — Swift will import everything this header exposes.
    header "EdgeBridgeEngine.hpp"
    
    // "requires cplusplus" tells the module system this is a C++ module,
    // which triggers Swift's C++ interop instead of the C/Objective-C path.
    requires cplusplus
    
    // Export everything so Swift can see all public types and methods.
    export *
}
